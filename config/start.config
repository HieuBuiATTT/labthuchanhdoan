GLOBAL_SETTINGS
    LAB_MASTER_SEED ssrf_enterprise_seed

NETWORK WAN_NET
    MASK 192.168.10.0/24
    GATEWAY 192.168.10.1

NETWORK INTERNAL_NET
    MASK 172.20.0.0/24
    GATEWAY 172.20.0.1

NETWORK SECURE_NET
    MASK 172.30.0.0/24
    GATEWAY 172.30.0.1

CONTAINER attacker
    USER ubuntu
    WAN_NET 192.168.10.50

CONTAINER sec-gateway
    USER ubuntu
    WAN_NET 192.168.10.2
    INTERNAL_NET 172.20.0.2

CONTAINER public-web
    USER ubuntu
    WAN_NET 192.168.10.10
    INTERNAL_NET 172.20.0.10
    SECURE_NET 172.30.0.10

CONTAINER honeypot-db
    USER ubuntu
    SECURE_NET 172.30.0.99
